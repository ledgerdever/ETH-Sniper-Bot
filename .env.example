# ── RPC ──────────────────────────────────────────────────────────────
# Use a private node or Chainstack/QuickNode for mempool access
RPC_WSS=wss://your-private-node/ws
RPC_HTTPS=https://your-private-node

# ── Wallet ────────────────────────────────────────────────────────────
PRIVATE_KEY=0xyour_private_key_here

# ── Flashbots ─────────────────────────────────────────────────────────
FLASHBOTS_RELAY_URL=https://relay.flashbots.net
# Optional: signing key for Flashbots reputation (different from wallet key)
FLASHBOTS_AUTH_KEY=0xyour_flashbots_auth_key

# ── GoPlus Safety API ─────────────────────────────────────────────────
GOPLUS_API_KEY=your_goplus_api_key

# ── Strategy ──────────────────────────────────────────────────────────
# Minimum ETH liquidity to consider a token (e.g. 3 = 3 ETH)
MIN_LIQUIDITY_ETH=3

# Buy amount in ETH (base amount, actual scaled by score)
BUY_AMOUNT_ETH=0.05

# Score threshold to buy (0-100)
MIN_SCORE=55

# Sell targets
TAKE_PROFIT_MULTIPLIER=3     # 3x = 300%
STOP_LOSS_MULTIPLIER=0.7     # -30%
TIER2_MULTIPLIER=5           # second sell tier
TIER3_MULTIPLIER=10          # moonbag tier

# Max tax % allowed (buy and sell)
MAX_TAX_PERCENT=10

# Max time to hold without hitting 2x (seconds)
MAX_HOLD_SECONDS=300

# ── Misc ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
DRY_RUN=false
